# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" no git nem o compartilhe.

# Porta do backend
PORT=3333

# URL exata do frontend em produção (ex.: https://venator.suaempresa.com).
# Deixe em branco em desenvolvimento local para liberar qualquer origem.
CORS_ORIGIN=

# Segredo usado para assinar os tokens JWT de login do Venator (frontend).
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Chave compartilhada entre o backend e o n8n. O n8n envia este valor no
# header "x-n8n-key" em toda chamada às rotas /api/n8n/*. Isso impede que
# qualquer pessoa na internet chame essas rotas internas.
N8N_SHARED_KEY=troque-por-um-valor-aleatorio-longo

# Credenciais iniciais do usuário master (podem ser trocadas depois via banco).
MASTER_EMAIL=adm@venator.com
MASTER_SENHA_HASH=

# --- WhatsApp Business Platform (Meta) ---
# Usados pelo próprio n8n (não pelo backend), mas documentados aqui para
# manter tudo em um único lugar de configuração.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-por-um-valor-aleatorio

# --- OpenAI ---
# Também usado pelo n8n, documentado aqui por referência.
OPENAI_API_KEY=
