    {
      "id": "extrair-msg",
      "name": "Extrair telefone, texto e nome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-640, 320],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extrai os dados da mensagem recebida no formato do WhatsApp Business Platform (Meta).\n// Referência: https://developers.facebook.com/docs/whatsapp/cloud-api/webhooks/payload-examples\nconst body = $input.item.json.body || $input.item.json;\nconst change = body?.entry?.[0]?.changes?.[0]?.value;\nconst mensagem = change?.messages?.[0];\n\nif (!mensagem) {\n  // Evento sem mensagem de texto (ex.: confirmação de leitura/entrega) — ignora.\n  return { json: { ignorar: true } };\n}\n\nconst contatoMeta = change?.contacts?.[0];\n\nreturn {\n  json: {\n    ignorar: false,\n    telefone: mensagem.from,\n    texto: mensagem.text?.body || \"\",\n    nome: contatoMeta?.profile?.name || mensagem.from\n  }\n};"
      }
    },
    {
      "id": "tem-mensagem",
      "name": "Tem mensagem de texto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-400, 320],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.ignorar}}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "buscar-contexto",
      "name": "Buscar contexto no CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 260],
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3333/api/n8n/context/{{encodeURIComponent($json.telefone)}}?nome={{encodeURIComponent($json.nome)}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }]
        },
        "options": {}
      }
    },
    {
      "id": "buscar-kb",
      "name": "Buscar base de conhecimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 260],
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3333/api/n8n/knowledge-base?query={{encodeURIComponent($('Extrair telefone, texto e nome').item.json.texto)}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }]
        },
        "options": {}
      }
    },
    {
      "id": "montar-prompt",
      "name": "Montar mensagens para a IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 260],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const contexto = $('Buscar contexto no CRM').item.json;\nconst kb = $('Buscar base de conhecimento').item.json;\nconst texto = $('Extrair telefone, texto e nome').item.json.texto;\n\nconst PROMPT_SDR = `Você é um SDR (Sales Development Representative) atendendo leads pelo WhatsApp em nome da empresa.\nQualifique o interesse do lead com perguntas curtas sobre necessidade, prazo e orçamento, de forma cordial e direta.\nVocê PODE apresentar informações de produto/preço usando a base de conhecimento abaixo, e fazer follow-up quando o lead sumir.\nNÃO feche a venda nem negocie condições finais — isso é sempre feito por um vendedor humano assim que o lead virar oportunidade quente.\nResponda em português do Brasil, no máximo 3 frases.\nSua saída deve ser SOMENTE um objeto JSON, sem texto fora dele, no formato exato:\n{\"resposta\": \"mensagem a enviar ao lead\", \"qualificado\": true ou false, \"quer_comprar\": true ou false, \"resumo_memoria\": \"resumo atualizado e curto do que já se sabe sobre este lead\"}`;\n\nconst blocoKb = (kb || []).map((a) => `# ${a.titulo}\\n${a.conteudo}`).join(\"\\n\\n\");\nconst memoriaAtual = contexto.memoria?.resumo || \"(nenhuma informação registrada ainda)\";\n\nconst historico = (contexto.mensagensRecentes || [])\n  .filter((m) => m.tipo === \"texto\")\n  .map((m) => ({ role: m.origem === \"lead\" ? \"user\" : \"assistant\", content: m.texto }));\n\nconst mensagens = [\n  { role: \"system\", content: `${PROMPT_SDR}\\n\\nMemória sobre este lead:\\n${memoriaAtual}\\n\\nBase de conhecimento relevante:\\n${blocoKb}` },\n  ...historico,\n  { role: \"user\", content: texto }\n];\n\nreturn { json: { mensagens, contatoId: contexto.contato.id, telefone: contexto.contato.telefone, textoRecebido: texto } };"
      }
    },
    {
      "id": "chamar-openai",
      "name": "Chamar OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 260],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{$credentials.openAiApi ? '' : 'COLOQUE_A_CREDENCIAL_OPENAI'}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", response_format: { type: \"json_object\" }, messages: $json.mensagens }) }}",
        "options": {}
      },
      "notes": "Prefira usar uma credencial 'Header Auth' ou a credencial nativa de OpenAI do n8n em vez de colar a chave direto no node."
    },
    {
      "id": "interpretar-ia",
      "name": "Interpretar resposta da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 260],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const anterior = $('Montar mensagens para a IA').item.json;\nconst bruto = $json.choices?.[0]?.message?.content || \"{}\";\nlet saida;\ntry {\n  saida = JSON.parse(bruto);\n} catch (e) {\n  saida = { resposta: \"Desculpe, tive um problema para responder agora. Um de nossos vendedores vai falar com você em breve.\", qualificado: false, quer_comprar: false, resumo_memoria: \"\" };\n}\nreturn {\n  json: {\n    ...anterior,\n    resposta: saida.resposta,\n    qualificado: !!saida.qualificado,\n    querComprar: !!saida.quer_comprar,\n    resumoMemoria: saida.resumo_memoria || \"\"\n  }\n};"
      }
    },
    {
      "id": "salvar-msg-lead",
      "name": "Salvar mensagem do lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 140],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3333/api/n8n/message",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contatoId: $json.contatoId, origem: \"lead\", texto: $json.textoRecebido }) }}",
        "options": {}
      }
    },
    {
      "id": "salvar-msg-ia",
      "name": "Salvar resposta da IA",
