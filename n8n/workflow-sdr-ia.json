        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contatoId: $json.contatoId, estagio: $json.querComprar ? \"Negociação\" : \"Interessado\" }) }}",
        "options": {}
