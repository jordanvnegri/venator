      "parameters": {
        "method": "PATCH",
        "url": "http://localhost:3333/api/n8n/memory",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contatoId: $json.contatoId, resumo: $json.resumoMemoria }) }}",
        "options": {}
      }
    },
    {
      "id": "lead-qualificado",
      "name": "Lead qualificado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1280, 260],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
