    },
    {
      "id": "notificar-vendedor",
      "name": "Notificar vendedor (lead quente)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 160],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3333/api/n8n/lead-quente",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-key", "value": "COLOQUE_AQUI_O_N8N_SHARED_KEY" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contatoId: $json.contatoId, motivo: $json.querComprar ? \"Intenção de compra identificada pela IA\" : \"Lead qualificado pela IA\" }) }}",
        "options": {}
      },
      "notes": "Troque/complemente esta chamada por um node de Slack/E-mail para avisar o vendedor em tempo real, além de registrar no backend."
    },
    {
      "id": "enviar-whatsapp",
      "name": "Enviar resposta no WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 260],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/COLOQUE_AQUI_O_PHONE_NUMBER_ID/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer COLOQUE_AQUI_O_WHATSAPP_TOKEN" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $json.telefone, type: \"text\", text: { body: $json.resposta } }) }}",
        "options": {}
      },
      "notes": "Prefira mover Authorization para uma credencial 'Header Auth' do n8n em vez de colar o token direto aqui."
    }
  ],
